		{
			"name": "[concat(parameters('factoryName'), '/Gold_df_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "sourceAdmisiones"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Pacientes",
								"type": "DatasetReference"
							},
							"name": "sourceDimPaciente"
						},
						{
							"dataset": {
								"referenceName": "DS_Gold_Departamentos",
								"type": "DatasetReference"
							},
