{
	"name": "Silver_df_patients",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(patient_id = toInteger(trim(patient_id)),",
				"          full_name = trim(full_name),",
				"          gender = case(",
				"              lower(trim(gender)) == 'm' || lower(trim(gender)) == 'male', 'Male',",
				"              lower(trim(gender)) == 'f' || lower(trim(gender)) == 'female', 'Female',",
				"              'Unknown'",
				"          ),",
				"          date_of_birth = case(",
				"              isNull(date_of_birth) || trim(date_of_birth) == '', toDate(null()),",
				"              regexMatch(trim(date_of_birth), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && isDate(trim(date_of_birth), 'yyyy-MM-dd'), toDate(trim(date_of_birth), 'yyyy-MM-dd'),",
				"              regexMatch(trim(date_of_birth), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$') && isDate(trim(date_of_birth), 'MM/dd/yyyy'), toDate(trim(date_of_birth), 'MM/dd/yyyy'),",
				"              regexMatch(trim(date_of_birth), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$') && isDate(iif(toInteger(substring(trim(date_of_birth), 7, 2)) <= 27, '20', '19') + substring(trim(date_of_birth), 7, 2) + '-' + substring(trim(date_of_birth), 1, 2) + '-' + substring(trim(date_of_birth), 4, 2), 'yyyy-MM-dd'), toDate(iif(toInteger(substring(trim(date_of_birth), 7, 2)) <= 27, '20', '19') + substring(trim(date_of_birth), 7, 2) + '-' + substring(trim(date_of_birth), 1, 2) + '-' + substring(trim(date_of_birth), 4, 2), 'yyyy-MM-dd'),",
				"              regexMatch(trim(date_of_birth), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$') && isDate(trim(date_of_birth), 'dd-MMM-yyyy'), toDate(trim(date_of_birth), 'dd-MMM-yyyy'),",
				"              regexMatch(trim(date_of_birth), '^[A-Za-z]+ [0-9]{2}, [0-9]{4}$') && isDate(trim(date_of_birth), 'MMMM dd, yyyy'), toDate(trim(date_of_birth), 'MMMM dd, yyyy'),",
				"              toDate(null())",
				"          ),",
				"          phone = iif(isNull(phone) || trim(phone) == '', 'Unknown', trim(phone)),",
				"          email = iif(isNull(email) || trim(email) == '', 'unknown@unknown.com', lower(trim(email))),",
				"          address = iif(isNull(address) || trim(address) == '', 'Unknown', trim(address)),",
				"          insurance_provider = iif(isNull(insurance_provider) || trim(insurance_provider) == '', 'Unknown', trim(insurance_provider))) ~> derivedColumn1",
				"derivedColumn1 alterRow(insertIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}