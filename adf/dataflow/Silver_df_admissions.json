{
	"name": "Silver_df_admissions",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Silver_Patients",
						"type": "DatasetReference"
					},
					"name": "sourcePatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "conditionalSplit1"
				},
				{
					"name": "alterRow1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          patient_id as integer",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourcePatients",
				"source1 derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
				"          admission_date = case(",
				"              isNull(admission_date) || trim(admission_date) == '', toDate(null()),",
				"              isDate(trim(admission_date), 'yyyy-MM-dd'), toDate(trim(admission_date), 'yyyy-MM-dd'),",
				"              regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$') && isDate(iif(toInteger(substring(trim(admission_date), 7, 2)) <= 27, '20', '19') + substring(trim(admission_date), 7, 2) + '-' + substring(trim(admission_date), 1, 2) + '-' + substring(trim(admission_date), 4, 2), 'yyyy-MM-dd'), toDate(iif(toInteger(substring(trim(admission_date), 7, 2)) <= 27, '20', '19') + substring(trim(admission_date), 7, 2) + '-' + substring(trim(admission_date), 1, 2) + '-' + substring(trim(admission_date), 4, 2), 'yyyy-MM-dd'),",
				"              isDate(trim(admission_date), 'MM/dd/yyyy'), toDate(trim(admission_date), 'MM/dd/yyyy'),",
				"              isDate(trim(admission_date), 'dd-MMM-yyyy'), toDate(trim(admission_date), 'dd-MMM-yyyy'),",
				"              isDate(trim(admission_date), 'MMMM dd, yyyy'), toDate(trim(admission_date), 'MMMM dd, yyyy'),",
				"              toDate(null())",
				"          ),",
				"          discharge_date = case(",
				"              isNull(discharge_date) || trim(discharge_date) == '', toDate(null()),",
				"              isDate(trim(discharge_date), 'yyyy-MM-dd'), toDate(trim(discharge_date), 'yyyy-MM-dd'),",
				"              regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$') && isDate(iif(toInteger(substring(trim(discharge_date), 7, 2)) <= 27, '20', '19') + substring(trim(discharge_date), 7, 2) + '-' + substring(trim(discharge_date), 1, 2) + '-' + substring(trim(discharge_date), 4, 2), 'yyyy-MM-dd'), toDate(iif(toInteger(substring(trim(discharge_date), 7, 2)) <= 27, '20', '19') + substring(trim(discharge_date), 7, 2) + '-' + substring(trim(discharge_date), 1, 2) + '-' + substring(trim(discharge_date), 4, 2), 'yyyy-MM-dd'),",
				"              isDate(trim(discharge_date), 'MM/dd/yyyy'), toDate(trim(discharge_date), 'MM/dd/yyyy'),",
				"              isDate(trim(discharge_date), 'dd-MMM-yyyy'), toDate(trim(discharge_date), 'dd-MMM-yyyy'),",
				"              isDate(trim(discharge_date), 'MMMM dd, yyyy'), toDate(trim(discharge_date), 'MMMM dd, yyyy'),",
				"              toDate(null())",
				"          ),",
				"          department = case(",
				"              lower(trim(department)) == 'onco' || lower(trim(department)) == 'oncologyy', 'Oncology',",
				"              lower(trim(department)) == 'cardio' || lower(trim(department)) == 'cardiolgy', 'Cardiology',",
				"              lower(trim(department)) == 'ortho' || lower(trim(department)) == 'orthopaedics', 'Orthopedics',",
				"              lower(trim(department)) == 'peds' || lower(trim(department)) == 'paediatrics', 'Pediatrics',",
				"              lower(trim(department)) == 'gen surg' || lower(trim(department)) == 'generalsurgery', 'General Surgery',",
				"              lower(trim(department)) == 'neuro' || lower(trim(department)) == 'nuerology', 'Neurology',",
				"              lower(trim(department)) == 'emergancy' || lower(trim(department)) == 'er', 'Emergency',",
				"              initCap(trim(department))",
				"          )) ~> derivedColumn1",
				"derivedColumn1, sourcePatients exists(derivedColumn1@patient_id == sourcePatients@patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 split(!isNull(admission_id) && !isNull(patient_id) && !isNull(admission_date) && !isNull(department) && department != '' && !isNull(attending_doctor_id) && (isNull(discharge_date) || discharge_date >= admission_date),",
				"     disjoint: false) ~> conditionalSplit1@(validRows, invalidRows)",
				"conditionalSplit1@validRows alterRow(insertIf(true())) ~> alterRow1",
				"alterRow1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}